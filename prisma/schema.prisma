// 衣橱镜像 · 数据模型
// 七张表：User / Garment / GarmentEvent / Label / VerificationCode / Outfit / OutfitItem
// 约定：状态与事件用 String 存（SQLite 不支持 Prisma enum），取值由 src/lib/status.ts 约束。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  sessionVersion Int      @default(0)
  createdAt    DateTime  @default(now())
  garments     Garment[]
  outfits      Outfit[]
}

model Garment {
  id           String         @id @default(cuid())
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  seq          Int
  name         String
  category     String
  primaryColor String?
  pattern      String?
  fit          String?
  season       String?        // 逗号分隔：春,秋；null/空 = 其他（未填写）
  style        String?
  material     String?
  brand        String?        @default("uncertain")
  priceCents   Int?
  purchaseDate DateTime?
  notes        String?
  photoPath    String
  status       String         @default("IN_CLOSET")
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  events       GarmentEvent[]
  label        Label?
  outfitItems  OutfitItem[]

  @@index([userId, createdAt])
  @@unique([userId, seq])
}

model GarmentEvent {
  id        String   @id @default(cuid())
  garmentId String
  garment   Garment  @relation(fields: [garmentId], references: [id], onDelete: Cascade)
  type      String
  createdAt DateTime @default(now())

  @@index([garmentId, createdAt])
}

model Label {
  id        String   @id @default(cuid())
  garmentId String   @unique
  garment   Garment  @relation(fields: [garmentId], references: [id], onDelete: Cascade)
  token     String   @unique
  createdAt DateTime @default(now())
}

// 邮箱验证码：只存哈希；用途当前固定 REGISTER；过期记录惰性清理。
model VerificationCode {
  id        String   @id @default(cuid())
  email     String
  codeHash  String
  purpose   String
  expiresAt DateTime
  attempts  Int      @default(0)
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  requestIp String

  @@index([email, purpose, used, createdAt])
  @@index([expiresAt])
  @@index([requestIp, createdAt])
}

// 固定搭配：一套 1–4 件；OutfitItem 保存顺序，删除衣物时级联移除但保留空搭配。
model Outfit {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  notes     String?
  items     OutfitItem[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([userId, updatedAt])
}

model OutfitItem {
  id        String @id @default(cuid())
  outfitId  String
  outfit    Outfit @relation(fields: [outfitId], references: [id], onDelete: Cascade)
  garmentId String
  garment   Garment @relation(fields: [garmentId], references: [id], onDelete: Cascade)
  position  Int

  @@unique([outfitId, garmentId])
  @@unique([outfitId, position])
  @@index([garmentId])
}
