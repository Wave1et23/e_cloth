{
  "name": "e-cloth",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --test tests/unit/status.test.ts tests/unit/cost.test.ts tests/unit/token.test.ts tests/unit/session.test.ts tests/unit/password.test.ts tests/unit/ai-schema.test.ts tests/unit/label-layout.test.ts tests/unit/scan.test.ts tests/unit/vision.test.ts tests/unit/images.test.ts tests/unit/image-compress.test.ts tests/unit/status-actions.test.ts tests/unit/garment-filter.test.ts tests/unit/garment-sort.test.ts tests/unit/season.test.ts tests/unit/outfits.test.ts tests/unit/rate-limit.test.ts tests/unit/verification.test.ts",
    "db:migrate": "prisma migrate dev",
    "db:seed": "node prisma/seed.ts",
    "db:seed:demo": "node prisma/seed-demo.ts",
    "eval:dry": "node tests/eval/run-ai-eval.ts --dry-run",
    "eval": "node tests/eval/run-ai-eval.ts",
    "eval:care:dry": "node tests/eval/run-care-label.ts --dry-run",
    "eval:care": "node tests/eval/run-care-label.ts",
    "try:photos": "node --env-file=.env tests/eval/try-photos.ts",
    "try:care": "node --env-file=.env tests/eval/try-care.ts",
    "care:batch": "node --env-file=.env tests/eval/batch-care-label.ts"
  },
  "prisma": {
    "seed": "node prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "next": "16.4.2",
    "nodemailer": "^10.1.7",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
