# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# database (SQLite)
*.db
*.db-journal
*.db-wal
*.db-shm
/prisma/*.db
/prisma/*.db-journal

# uploaded garment photos
/uploads/
/backup/

# eval photos and results (user-supplied, not source)
/tests/eval/images/*
!/tests/eval/images/README.md
/tests/eval/care-images/*
!/tests/eval/care-images/README.md
/tests/eval/results/

# logs
*.log

# 本地私有资料：赛题原文、个人工作随记等，不进仓库
/private/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
