# 复制本文件为 .env.local 后填写真实值
# .env.local 已被 .gitignore 忽略，切勿提交

# SQLite 数据库文件位置
DATABASE_URL="file:./dev.db"

# 会话签名密钥：用 `openssl rand -base64 32` 生成，不要与任何人共享
SESSION_SECRET=

# 火山方舟（Ark）视觉模型
ARK_API_KEY=
ARK_BASE_URL="https://ark.cn-beijing.volces.com/api/v3"
ARK_MODEL="doubao-seed-2-1-lite-260915"

# 二维码里写入的站点地址（必须是正式域名 + https，结尾不带斜杠）
APP_BASE_URL="https://example.com"

# 视觉调用次数上限（超限只打警告日志，不阻断）
AI_CALL_BUDGET=300

# 本地没有 ARK_API_KEY 时设为 1：AI 返回固定 mock 建议，仅用于开发验收；上线前必须删掉
AI_MOCK=

# 邮件发送：console（本地）/ smtp（真实服务商）
MAIL_PROVIDER=console
# 控制台模式不真发信，只把 6 位验证码打到服务端日志（仅非 production）
MAIL_CONSOLE_LOG_CODE=1
# SMTP（163 默认；授权码/密码只写本地 .env，不要提交）
MAIL_SMTP_HOST=smtp.163.com
MAIL_SMTP_PORT=465
MAIL_SMTP_SECURE=1
MAIL_SMTP_USER=
MAIL_SMTP_PASS=
MAIL_FROM=

# 仅 development 生效：设为 1 可跳过注册验证码；production 会忽略并要求验证码；上线前必须为 0
REGISTER_SKIP_EMAIL_VERIFICATION=0
