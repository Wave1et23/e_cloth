# 复制本文件为 .env.local 后填写真实值
# .env.local 已被 .gitignore 忽略，切勿提交

# SQLite 数据库文件位置
DATABASE_URL="file:./dev.db"

# 会话签名密钥：用 `openssl rand -base64 32` 生成，不要与任何人共享
SESSION_SECRET=

# 火山方舟（Ark）视觉模型
ARK_API_KEY=
ARK_BASE_URL="https://ark.cn-beijing.volces.com/api/v3"
ARK_MODEL="doubao-seed-2-1-lite-260915"

# 二维码里写入的站点地址（必须是正式域名 + https，结尾不带斜杠）
APP_BASE_URL="https://example.com"

# 视觉调用次数上限（超限只打警告日志，不阻断）
AI_CALL_BUDGET=300
